{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fracture-viewer/data/:file(.*).gz",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/fracture-viewer", "destination": "/fracture-viewer/index.html" }
  ],
  "redirects": [
    {
      "source": "/theory.html",
      "destination": "/hub.html#basic-equations",
      "permanent": true
    },
    {
      "source": "/equations.html",
      "destination": "/hub.html#basic-equations",
      "permanent": true
    }
  ]
}
